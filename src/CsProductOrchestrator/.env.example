# Environment variables for CsProductOrchestrator
# Copy this file to .env and fill in your actual values

# Product API URL (will be set automatically after infrastructure deployment)
PRODUCT_API_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/prod/api/data

# For local development, you can use:
# PRODUCT_API_URL=http://localhost:5000/api/data

# Note: OpenAI API key is now provided in the request body, not as an environment variable
# Request format: {"query": "your question", "openAiApiKey": "your-openai-api-key"}